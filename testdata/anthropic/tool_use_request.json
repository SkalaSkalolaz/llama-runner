{
  "model": "llama-server",
  "max_tokens": 4096,
  "temperature": 1,
  "system": [
    {
      "type": "text",
      "text": "You are Claude Code, Anthropic's official CLI for Claude."
    }
  ],
  "tools": [
    {
      "name": "Bash",
      "description": "Executes a given bash command and returns its output.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "The command to execute"
          },
          "description": {
            "type": "string",
            "description": "Clear, concise description of what this command does"
          }
        },
        "required": ["command"]
      }
    },
    {
      "name": "Read",
      "description": "Read a file from the local filesystem.",
      "input_schema": {
        "type": "object",
        "properties": {
          "file_path": {
            "type": "string",
            "description": "Absolute path to the file to read"
          }
        },
        "required": ["file_path"]
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": "Покажи, сколько строк в proxy.go"
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "text",
          "text": "Посчитаю строки."
        },
        {
          "type": "tool_use",
          "id": "toolu_01Bvg9z8HrCw",
          "name": "Bash",
          "input": {
            "command": "wc -l proxy.go",
            "description": "Count lines in proxy.go"
          }
        }
      ]
